DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_USE_SQLITE=true
SQLITE_DATABASE_PATH=db.sqlite3
# Local/portfolio default: use backend/media and backend/staticfiles.
# Set true only after provisioning a bucket and reviewing its costs.
DJANGO_USE_S3=false
YOLO_CONFIG_DIR=.cache/ultralytics
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_BEHIND_HTTPS_PROXY=false

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Optional runtime artifacts
YOLO_MODEL_PATH=best.pt
YOLO_AUGMENTED_INFERENCE=true
CHROMA_DB_PATH=artifacts/chroma
CHATBOT_SOURCE_CSV=chatbot/chatbot_source.csv

# Agriculture chatbot (disabled by default because provider calls are billed)
CHATBOT_ENABLED=false
CHATBOT_LLM_MODEL=gpt-4o-mini
CHATBOT_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_COLLECTION_NAME=agriculture-knowledge
SOIL_SERVICE_ENABLED=true
PREDICTION_SERVICE_ENABLED=true

DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432

KAKAO_REST_API_KEY=
DATA_GO_KR_MARKET_SERVICE_KEY=
DATA_GO_KR_WEATHER_SERVICE_KEY=
DATA_GO_KR_SOIL_SERVICE_KEY=
DATA_GO_KR_FERTILIZER_V2_SERVICE_KEY=
OPENAI_API_KEY=

# Optional S3 settings (unused while DJANGO_USE_S3=false).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_LOCATION=

EMAIL_HOST=smtp.gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
