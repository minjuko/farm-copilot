# Copy this file to .env on the production host and replace every placeholder.
# Never commit the resulting .env file.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_USE_SQLITE=false

DATABASE_NAME=replace-me
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me
DATABASE_HOST=replace-me
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=https://www.example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com
FRONTEND_BASE_URL=https://www.example.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
# Enable only when a trusted load balancer/reverse proxy terminates TLS.
DJANGO_BEHIND_HTTPS_PROXY=true

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=replace-me@example.com

# S3 is recommended on hosts with an ephemeral filesystem. When false, mount
# persistent volumes for both backend/media and backend/staticfiles.
DJANGO_USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_LOCATION=

KAKAO_REST_API_KEY=replace-me
DATA_GO_KR_WEATHER_SERVICE_KEY=replace-me
DATA_GO_KR_SOIL_SERVICE_KEY=replace-me
DATA_GO_KR_FERTILIZER_V2_SERVICE_KEY=replace-me
DATA_GO_KR_MARKET_SERVICE_KEY=replace-me

SOIL_SERVICE_ENABLED=true
PREDICTION_SERVICE_ENABLED=true
YOLO_MODEL_PATH=best.pt
YOLO_AUGMENTED_INFERENCE=true
YOLO_CONFIG_DIR=.cache/ultralytics

# Keep disabled until a reviewed source CSV and matching Chroma index exist.
CHATBOT_ENABLED=false
OPENAI_API_KEY=
CHATBOT_LLM_MODEL=gpt-4o-mini
CHATBOT_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_COLLECTION_NAME=agriculture-knowledge
CHATBOT_SOURCE_CSV=artifacts/chatbot.csv
CHROMA_DB_PATH=artifacts/chroma
